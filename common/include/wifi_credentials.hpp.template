/**
 * @file wifi_credentials.hpp.template
 * @brief Template for shared Wi-Fi configuration across the Zypher ecosystem.
 *
 * SECURITY ADVISORY:
 * This is a boilerplate file. For production use, copy this file to
 * 'wifi_credentials.hpp' and enter your local network credentials.
 * The real 'wifi_credentials.hpp' is excluded from Git to prevent
 * credential leakage.
 */

#pragma once

/**
 * @struct WifiCredential
 * @brief POD structure for network authentication parameters.
 */
struct WifiCredential {
    const char* ssid; /**< Service Set Identifier (Network Name) */
    const char* pass; /**< WPA2/WPA3 Pre-Shared Key (Password) */
};

/**
 * @brief Static list of available Wi-Fi networks.
 *
 * The Zypher WifiManager will iterate through these entries in order
 * until a stable IP address is allocated via DHCP.
 */
static const WifiCredential wifi_credentials[] = {
    {"YOUR_SSID_1", "YOUR_PASSWORD_1"}, /**< Primary network */
    {"YOUR_SSID_2", "YOUR_PASSWORD_2"}  /**< Fallback network */
};
