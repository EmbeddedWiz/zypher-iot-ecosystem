{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESP32-S3 Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wifi_station.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${command:espIdf.getToolchainGdb}",
      "miDebuggerServerAddress": "localhost:3333",
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "openocd",
      "setupCommands": [
        {
          "text": "monitor reset halt",
          "ignoreFailures": true
        }
      ]
    }
  ]
}